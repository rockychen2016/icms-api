{
  "name": "icms-api",
  "private": false,
  "version": "0.0.3",
  "description": "对iCMS内容管理系统API的封装，使用该API能快速使用iCMS搭建您的WebApp!",
  "type": "module",
  "main": "./dist/icms-api.cjs.js",
  "module": "./dist/icms-api.es.js",
  "browser": "./dist/icms-api.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/icms-api.es.js",
      "require": "./dist/icms-api.cjs.js",
      "default": "./dist/icms-api.es.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "test": "vitest run",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "nextjs:dev": "cd simple-nextjs && npm install && npm run dev",
    "nuxtjs:dev": "cd simple-nuxtjs && npm install && npm run dev"
  },
  "keywords": [
    "cms",
    "website",
    "app",
    "api",
    "wechat"
  ],
  "author": "Rock.chen<szygnet@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rockychen2016/icms-api.git"
  },
  "bugs": {
    "url": "https://github.com/rockychen2016/icms-api/issues"
  },
  "homepage": "https://github.com/rockychen2016/icms-api#readme",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "pino-pretty": "^13.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@rock.chen/icms-http-client": "^1.0.4"
  }
}
